# پیکربندی nginx داخل کانتینر — استقرار روی VPS
# ${DOMAIN} و ${BACKEND_UPSTREAM} هنگام بالا آمدن کانتینر جایگزین می‌شوند.
#
# این nginx دیگر TLS را خودش انجام نمی‌دهد و پورت ۸۰/۴۴۳ را به بیرون منتشر
# نمی‌کند؛ فقط از طریق یک پورت لوکال (مثلاً 127.0.0.1:8081) در دسترس nginx
# سطح میزبان است، که SSL چند پروژه روی همین سرور را با هم مدیریت می‌کند.
# هدرهای امنیتی (HSTS و…) هم آنجا تنظیم می‌شوند، نه اینجا — دوباره تنظیم‌شان
# اینجا فقط باعث تکرار هدر در پاسخ نهایی می‌شود.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # بررسی سلامت خود این کانتینر (برای HEALTHCHECK در Dockerfile)
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # تصاویر چهره و بسته‌های همگام‌سازی آفلاین base64 هستند و حجیم می‌شوند.
    # nginx سطح میزبان هم باید همین مقدار (یا بیشتر) را برای این دامنه تنظیم
    # کند، وگرنه درخواست‌های بزرگ قبل از رسیدن به اینجا رد می‌شوند.
    client_max_body_size 25m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/manifest+json;

    # --------------------------------------------------------------- API
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # این کانتینر همیشه از nginx سطح میزبان روی HTTP خام درخواست می‌گیرد؛
        # $scheme اینجا همیشه "http" است، پس همان مقداری را که میزبان قبلاً
        # در این هدر گذاشته دست‌نخورده رد می‌کنیم تا FastAPI طرحواره واقعی
        # (https) را که کاربر دیده ببیند.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    # ------------------------------------------------- تصاویر چهره و ترددها
    # مهم: این مسیر عمداً از سرور رد می‌شود و مستقیم از دیسک سرو نمی‌شود.
    # کنترل دسترسی (کوکی HttpOnly) داخل FastAPI است؛ اگر nginx خودش فایل‌ها را
    # بدهد، عکس چهره همه پرسنل عملاً عمومی می‌شود.
    location /static/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location = /docs {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
    location = /openapi.json {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # ------------------------------------------------------ رابط کاربری
    root /usr/share/nginx/html;
    index index.html;

    # مدل‌های تشخیص چهره حجیم و بدون تغییرند — کش طولانی
    location /models/ {
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # فایل‌های ساخته‌شده نام هش‌دار دارند
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # این‌ها هرگز نباید کش شوند وگرنه به‌روزرسانی برنامه روی تبلت گیر می‌کند
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }

    # مسیریابی سمت کلاینت (React Router)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
