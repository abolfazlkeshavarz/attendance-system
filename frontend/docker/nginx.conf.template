# پیکربندی nginx برای استقرار روی VPS
# ${DOMAIN} و ${BACKEND_UPSTREAM} هنگام بالا آمدن کانتینر جایگزین می‌شوند.

# ------------------------------------------------- HTTP: فقط ACME و هدایت به HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # بررسی سلامت خود nginx (بدون هدایت، وگرنه healthcheck شکست می‌خورد)
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # مسیر تأیید مالکیت دامنه برای certbot — نباید هدایت شود
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ------------------------------------------------------------------ HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;

    # تصاویر چهره و بسته‌های همگام‌سازی آفلاین base64 هستند و حجیم می‌شوند
    client_max_body_size 25m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/manifest+json;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # --------------------------------------------------------------- API
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # ------------------------------------------------- تصاویر چهره و ترددها
    # مهم: این مسیر عمداً از سرور رد می‌شود و مستقیم از دیسک سرو نمی‌شود.
    # کنترل دسترسی (کوکی HttpOnly) داخل FastAPI است؛ اگر nginx خودش فایل‌ها را
    # بدهد، عکس چهره همه پرسنل عملاً عمومی می‌شود.
    location /static/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /docs      { proxy_pass http://${BACKEND_UPSTREAM}; proxy_set_header Host $host; }
    location = /openapi.json { proxy_pass http://${BACKEND_UPSTREAM}; proxy_set_header Host $host; }

    # ------------------------------------------------------ رابط کاربری
    root /usr/share/nginx/html;
    index index.html;

    # مدل‌های تشخیص چهره حجیم و بدون تغییرند — کش طولانی
    location /models/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # فایل‌های ساخته‌شده نام هش‌دار دارند
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # این‌ها هرگز نباید کش شوند وگرنه به‌روزرسانی برنامه روی تبلت گیر می‌کند
    location = /sw.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    # مسیریابی سمت کلاینت (React Router)
    location / {
        try_files $uri $uri/ /index.html;
    }
}