# تنظیمات استقرار روی سرور (Docker)
#
# این فایل را کپی نکنید — دستور «make setup» خودش .env را می‌سازد و
# کلیدهای تصادفی امن تولید می‌کند. فقط DOMAIN و LETSENCRYPT_EMAIL را
# بعدش دستی پر کنید.

# ------------------------------------------------------------- دامنه و SSL
# دامنه‌ای که رکورد A آن به IP این سرور اشاره می‌کند
DOMAIN=hozur.example.com

# ایمیل برای هشدار انقضای گواهی از طرف Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com

# برای آزمایش روی true بگذارید تا محدودیت تعداد درخواست Let's Encrypt نخورید.
# گواهی حالت آزمایشی در مرورگر «نامعتبر» نشان داده می‌شود.
LETSENCRYPT_STAGING=false

# ------------------------------------------------------------ پایگاه داده
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=

# ----------------------------------------------------------------- امنیت
# با «make setup» خودکار پر می‌شود. اگر دستی می‌سازید:
#   openssl rand -base64 48
SECRET_KEY=

# ------------------------------------------------------------- مدیر اولیه
# فقط بار اول (وقتی جدول کاربران خالی است) ساخته می‌شود
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=SystemAdmin

# ------------------------------------------------------------ منطقه زمانی
TIMEZONE=Asia/Tehran

# --------------------------------------------------------- تشخیص چهره
# آستانه شباهت روی بردار ۱۲۸بُعدی. کمتر = سخت‌گیرتر.
FACE_MATCH_THRESHOLD=0.60

# --------------------------------------------------------- زنده بودن چهره
# جلوی ثبت تردد با عکس چاپی یا عکس روی گوشی را می‌گیرد.
# اگر (و فقط اگر) پرسنل نتوانستند از این مرحله رد شوند، false کنید.
REQUIRE_LIVENESS=true
# حداقل چرخش سر برای تأیید. اگر تأیید سخت بود کمترش کنید (مثلاً 0.045)،
# اگر خیلی راحت رد می‌شود بیشترش کنید (مثلاً 0.08).
LIVENESS_TURN_THRESHOLD=0.06
LIVENESS_TIMEOUT_SECONDS=12
