# تنظیمات اجرای محلی با Docker (بدون دامنه، بدون SSL)
#
# این فایل را کپی نکنید — دستور «make local-setup» خودش .env.local را می‌سازد
# و کلیدهای تصادفی امن تولید می‌کند.
#
# این پیکربندی فقط برای آزمایش روی همین سیستم است، نه بهره‌برداری واقعی.
# برای استقرار روی سرور واقعی از .env.example و «make setup» استفاده کنید.

# ------------------------------------------------------------------ دسترسی
# پورتی که سامانه روی آن در دسترس است: http://localhost:<این پورت>
LOCAL_PORT=8080

# پورت HTTPS — برای اتصال گوشی (به‌عنوان تبلت ورودی) از طریق شبکه داخلی.
# گواهی‌اش را با «make local-cert» بسازید: https://<IP این سیستم>:<این پورت>/kiosk
LOCAL_HTTPS_PORT=8443

# با «make local-cert» پر می‌شود — فقط برای نمایش آدرس در خروجی «make local-up»
LOCAL_LAN_IP=

# ------------------------------------------------------------------ پایگاه داده
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=

# ----------------------------------------------------------------- امنیت
# با «make local-setup» خودکار پر می‌شود. اگر دستی می‌سازید:
#   openssl rand -base64 48
SECRET_KEY=

# ------------------------------------------------------------- مدیر اولیه
# فقط بار اول (وقتی جدول کاربران خالی است) ساخته می‌شود
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=مدیر سامانه

# ------------------------------------------------------------ منطقه زمانی
TIMEZONE=Asia/Tehran

# --------------------------------------------------------- تشخیص چهره
FACE_MATCH_THRESHOLD=0.60

# --------------------------------------------------------- زنده بودن چهره
# روی محیط محلی معمولاً خاموش کردنش برای آزمایش سریع‌تر راحت‌تر است؛
# اگر می‌خواهید همان رفتار تولید را آزمایش کنید، true بگذارید.
REQUIRE_LIVENESS=true
LIVENESS_TURN_THRESHOLD=0.06
LIVENESS_TIMEOUT_SECONDS=12
