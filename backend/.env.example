# ------------------------------------------------------------------ عمومی
DEBUG=false

# ------------------------------------------------------------ پایگاه داده
# پیش‌فرض: SQLite (برای کارخانه‌های کوچک و متوسط کافی است)
# DATABASE_URL=sqlite:///D:/attendance/attendance.db
#
# برای تولید با PostgreSQL:
# DATABASE_URL=postgresql+psycopg://attendance:PASSWORD@localhost:5432/attendance

# ---------------------------------------------------------------- امنیت
# حتماً عوض کنید. یک رشته تصادفی بلند بسازید:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# --------------------------------------------------------- مدیر اولیه
# فقط بار اول (وقتی جدول کاربران خالی است) ساخته می‌شود
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin1234
FIRST_ADMIN_NAME=مدیر سامانه

# تصاویر چهره و عکس ترددها پشت یک کوکی HttpOnly سرو می‌شوند.
# در تولید (پشت HTTPS) روی true بگذارید تا کوکی فقط روی اتصال امن ارسال شود.
SECURE_COOKIES=false

# --------------------------------------------------------- منطقه زمانی
TIMEZONE=Asia/Tehran

# ------------------------------------------------------- تشخیص چهره
# مدل: MobileFaceNet+ArcFace (۵۱۲بُعدی) — جزئیات در
# frontend/public/models/mobilefacenet/MODEL_INFO.md. فقط برای مصارف
# غیرتجاری مجاز است.
#
# آستانهٔ شباهتِ کسینوسی — میانگینِ بیشترین شباهت به ۳ نمونهٔ هر پرسنل با آن
# مقایسه می‌شود، نه فقط شبیه‌ترین یکی.
# بیشتر = سخت‌گیرتر (احتمال «شناسایی نشد» بیشتر)
# کمتر = آسان‌گیرتر (احتمال اشتباه گرفتن دو نفر بیشتر)
# اگر بعد از ثبت‌نامِ ۵ نمونه‌ای هنوز افرادِ ثبت‌نام‌نشده تأیید می‌شوند، آن را
# کمی افزایش دهید (مثلاً 0.48)؛ اگر افرادِ ثبت‌نام‌شده زیاد رد می‌شوند، کمی
# کاهش دهید.
FACE_MATCH_THRESHOLD=0.42
# حداقل فاصله بین دو تردد هم‌نوع یک نفر (ثانیه)
MIN_SECONDS_BETWEEN_PUNCHES=60

# --------------------------------------------------------------- CORS
# دامنه پنل و تبلت‌ها. در تولید حتماً محدود کنید:
# CORS_ORIGINS=https://hozur.example.com,http://192.168.1.50
CORS_ORIGINS=*
